<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentation.controller.ArticleTableController" spacing="16" styleClass="workspace">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Статьи" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="gridViewBtn" text="Карточками"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Название, текст или ID" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="statusFilterCombo" prefWidth="195" promptText="Все статусы"/>
        <ComboBox fx:id="authorFilterCombo" prefWidth="190" promptText="Все авторы"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="addBtn" text="Добавить" styleClass="btn-primary"/>
        <Button fx:id="editBtn" text="Изменить"/>
        <Button fx:id="deleteBtn" text="Удалить" styleClass="btn-destructive"/>
        <Button fx:id="exportBtn" text="Экспорт в Excel"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted"/>
    </HBox>
    <TableView fx:id="articleTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
            <TableColumn fx:id="titleColumn" text="Заголовок" prefWidth="380"/>
            <TableColumn fx:id="authorColumn" text="Автор" prefWidth="180"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="195"/>
            <TableColumn fx:id="dateColumn" text="Дата публикации" prefWidth="160"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <placeholder><Label text="Статьи не найдены"/></placeholder>
    </TableView>
</VBox>
